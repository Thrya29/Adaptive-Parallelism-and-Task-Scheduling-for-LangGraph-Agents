# Copy to `.env` (which is git-ignored) and edit. Everything is optional.

# auto (default): use Anthropic if ANTHROPIC_API_KEY is set, otherwise the free mock LLM
# mock          : always use the deterministic mock LLM
# anthropic     : require a real key
APSCHED_LLM_PROVIDER=auto

# Get a key at https://console.anthropic.com (separate from a Claude.ai subscription).
# Leave empty to run fully offline on the mock LLM.
ANTHROPIC_API_KEY=

APSCHED_ANTHROPIC_MODEL=claude-haiku-5-5
APSCHED_MAX_CONCURRENCY=8
APSCHED_MOCK_TIME_SCALE=0.1
APSCHED_SELECTOR_SAMPLES=64
APSCHED_MOCK_SEED=0
APSCHED_LOG_LEVEL=INFO
